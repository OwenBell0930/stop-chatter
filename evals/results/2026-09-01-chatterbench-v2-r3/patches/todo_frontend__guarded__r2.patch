diff --git a/styles.css b/styles.css
index f1cf2c1..dc2e214 100644
--- a/styles.css
+++ b/styles.css
@@ -1,4 +1,46 @@
-body { font-family: system-ui, sans-serif; max-width: 640px; margin: 40px auto; }
-.requirement { color: #777; }
-.admin-link { font-weight: 700; }
+:root {
+  color: #24313b;
+  background: #f4f7f6;
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
+}
 
+* { box-sizing: border-box; }
+
+body { margin: 0; }
+
+.todo-app {
+  width: min(100% - 32px, 640px);
+  margin: 72px auto;
+  padding: 36px;
+  background: #fff;
+  border: 1px solid #dfe9e5;
+  border-radius: 20px;
+  box-shadow: 0 18px 50px rgba(33, 61, 52, .08);
+}
+
+.app-header { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
+.eyebrow { margin: 0 0 8px; color: #4f8c78; font-size: 12px; font-weight: 800; letter-spacing: .16em; }
+h1 { margin: 0; font-size: clamp(30px, 7vw, 42px); letter-spacing: -.04em; }
+.task-count { color: #6b7b75; font-size: 14px; }
+.todo-form { display: flex; gap: 10px; margin-bottom: 24px; }
+.todo-form input { min-width: 0; flex: 1; padding: 14px 16px; border: 1px solid #d7e2de; border-radius: 11px; color: inherit; font: inherit; outline: none; }
+.todo-form input:focus { border-color: #4f8c78; box-shadow: 0 0 0 3px rgba(79, 140, 120, .14); }
+button { border: 0; border-radius: 11px; cursor: pointer; font: inherit; }
+.todo-form button { padding: 0 21px; background: #2f6f5d; color: #fff; font-weight: 700; }
+.todo-form button:hover { background: #245b4c; }
+.todo-list { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
+.usage-hint { margin: 14px 0 0; color: #82918b; font-size: 13px; text-align: center; }
+.todo-item { display: flex; align-items: center; gap: 14px; padding: 15px 14px; border: 1px solid #e5eeeb; border-radius: 12px; }
+.toggle-button { display: grid; width: 24px; height: 24px; flex: 0 0 24px; place-items: center; border: 1.5px solid #9bb6ab; border-radius: 50%; background: #fff; color: #fff; font-size: 14px; font-weight: 800; }
+.toggle-button:hover { border-color: #2f6f5d; }
+.is-completed .toggle-button { border-color: #2f6f5d; background: #2f6f5d; }
+.todo-text { overflow-wrap: anywhere; }
+.is-completed .todo-text { color: #99a8a2; text-decoration: line-through; }
+.empty-state { margin: 26px 0 4px; color: #7b8b85; text-align: center; }
+.empty-state[hidden] { display: none; }
+.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
+
+@media (max-width: 520px) {
+  .todo-app { margin: 24px auto; padding: 24px 18px; }
+  .todo-form button { padding: 0 16px; }
+}
