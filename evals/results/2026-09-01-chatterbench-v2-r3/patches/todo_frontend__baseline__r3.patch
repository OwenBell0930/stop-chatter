diff --git a/styles.css b/styles.css
index f1cf2c1..e5f7f80 100644
--- a/styles.css
+++ b/styles.css
@@ -1,4 +1,75 @@
-body { font-family: system-ui, sans-serif; max-width: 640px; margin: 40px auto; }
-.requirement { color: #777; }
-.admin-link { font-weight: 700; }
+* { box-sizing: border-box; }
 
+body {
+  margin: 0;
+  min-height: 100vh;
+  padding: 48px 20px;
+  color: #172033;
+  background: #f4f6fb;
+  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
+
+.todo-app {
+  max-width: 640px;
+  margin: 0 auto;
+  padding: 32px;
+  background: #fff;
+  border: 1px solid #e4e8f1;
+  border-radius: 16px;
+  box-shadow: 0 12px 32px rgb(23 32 51 / 8%);
+}
+
+.todo-header {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 16px;
+  margin-bottom: 24px;
+}
+
+h1 { margin: 0; font-size: 28px; }
+
+.todo-summary { margin: 0; color: #667085; font-size: 14px; }
+
+.todo-list { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
+
+.todo-hint { margin: 16px 0 0; color: #667085; font-size: 13px; }
+
+.todo-item {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 16px;
+  border: 1px solid #e4e8f1;
+  border-radius: 10px;
+}
+
+.todo-title { font-size: 16px; }
+
+.is-completed .todo-title { color: #98a2b3; text-decoration: line-through; }
+
+.todo-toggle {
+  flex: 0 0 auto;
+  min-width: 72px;
+  padding: 8px 12px;
+  color: #fff;
+  background: #315efb;
+  border: 0;
+  border-radius: 8px;
+  cursor: pointer;
+  font: inherit;
+}
+
+.todo-toggle:hover { background: #2449cf; }
+
+.todo-toggle[aria-pressed="true"] { color: #315efb; background: #eaf0ff; }
+
+.todo-toggle:focus-visible { outline: 3px solid rgb(49 94 251 / 35%); outline-offset: 2px; }
+
+@media (max-width: 480px) {
+  body { padding: 20px 12px; }
+  .todo-app { padding: 24px 16px; }
+  .todo-header { display: block; }
+  .todo-summary { margin-top: 8px; }
+}
