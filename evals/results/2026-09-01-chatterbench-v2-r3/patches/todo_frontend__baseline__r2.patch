@@ -1,4 +1,25 @@
-body { font-family: system-ui, sans-serif; max-width: 640px; margin: 40px auto; }
-.requirement { color: #777; }
-.admin-link { font-weight: 700; }
+* { box-sizing: border-box; }
 
+body {
+  margin: 0;
+  min-height: 100vh;
+  padding: 48px 20px;
+  color: #202124;
+  background: #f6f7fb;
+  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
+
+.todo-app { max-width: 640px; margin: 0 auto; }
+.page-header { margin-bottom: 28px; }
+.eyebrow { margin: 0 0 8px; color: #5d62d6; font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
+h1 { margin: 0; font-size: clamp(32px, 8vw, 48px); letter-spacing: -.04em; }
+.subtitle { margin: 10px 0 0; color: #6c7080; }
+.todo-list { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
+.usage-hint { margin: 16px 0 0; color: #8a8e9d; font-size: 13px; text-align: center; }
+.todo-item { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 20px; border: 1px solid #e5e7ef; border-radius: 16px; background: #fff; box-shadow: 0 5px 18px rgb(34 40 72 / 5%); font-size: 16px; transition: opacity .2s, background .2s; }
+.todo-item.is-completed { color: #8a8e9d; background: #f0f1f6; }
+.todo-item.is-completed span { text-decoration: line-through; }
+.toggle-button { min-width: 72px; padding: 9px 13px; border: 0; border-radius: 10px; color: #fff; background: #5d62d6; font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; }
+.toggle-button:hover { background: #4c51c4; }
+.toggle-button:focus-visible { outline: 3px solid #c7c9ff; outline-offset: 2px; }
+.is-completed .toggle-button { color: #464a62; background: #dfe1eb; }
