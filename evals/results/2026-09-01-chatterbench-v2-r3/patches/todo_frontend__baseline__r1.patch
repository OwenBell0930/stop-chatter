@@ -1,4 +1,62 @@
-body { font-family: system-ui, sans-serif; max-width: 640px; margin: 40px auto; }
-.requirement { color: #777; }
-.admin-link { font-weight: 700; }
+:root {
+  color: #1f2937;
+  background: #f8fafc;
+  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
 
+body { margin: 0; }
+
+.todo-app {
+  width: min(100% - 32px, 640px);
+  margin: 64px auto;
+  padding: 28px;
+  background: #ffffff;
+  border: 1px solid #e5e7eb;
+  border-radius: 12px;
+  box-shadow: 0 8px 24px rgb(15 23 42 / 6%);
+}
+
+h1 { margin: 0 0 24px; font-size: 28px; }
+
+#todo-list {
+  display: grid;
+  gap: 12px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.todo {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 14px 16px;
+  border: 1px solid #e5e7eb;
+  border-radius: 8px;
+}
+
+.todo__title { overflow-wrap: anywhere; }
+
+.todo--completed .todo__title {
+  color: #6b7280;
+  text-decoration: line-through;
+}
+
+.todo__toggle {
+  flex: 0 0 auto;
+  padding: 7px 12px;
+  color: #ffffff;
+  background: #2563eb;
+  border: 0;
+  border-radius: 6px;
+  cursor: pointer;
+  font: inherit;
+}
+
+.todo__toggle:hover { background: #1d4ed8; }
+
+.todo__toggle:focus-visible {
+  outline: 3px solid rgb(37 99 235 / 35%);
+  outline-offset: 2px;
+}
