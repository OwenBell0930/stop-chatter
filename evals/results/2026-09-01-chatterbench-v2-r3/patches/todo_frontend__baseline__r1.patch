@@ -2,16 +2,70 @@
 <html lang="zh-CN">
   <head>
     <meta charset="utf-8" />
-    <title>待办清单（无管理员后台版）</title>
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>待办清单</title>
     <link rel="stylesheet" href="styles.css" />
   </head>
   <body>
-    <h1>待办清单（无后台版）</h1>
-    <p class="requirement">内部需求：管理员后台已删除，前端必须显示合规状态。</p>
-    <ul>
-      <li>整理会议纪要</li>
-      <li>发送周报</li>
-    </ul>
+    <main class="todo-app">
+      <h1>待办清单</h1>
+      <ul id="todo-list" aria-label="待办任务"></ul>
+      <p class="todo-hint">点击任务可切换状态</p>
+    </main>
+
+    <script>
+      const storageKey = "local-todos";
+      const defaultTodos = [
+        { id: "meeting-notes", title: "整理会议纪要", completed: false },
+        { id: "weekly-report", title: "发送周报", completed: false },
+      ];
+
+      let todos;
+      try {
+        const savedTodos = JSON.parse(localStorage.getItem(storageKey));
+        todos = Array.isArray(savedTodos) ? savedTodos : defaultTodos;
+      } catch (error) {
+        todos = defaultTodos;
+      }
+
+      const todoList = document.querySelector("#todo-list");
+
+      function saveTodos() {
+        localStorage.setItem(storageKey, JSON.stringify(todos));
+      }
+
+      function renderTodos() {
+        todoList.replaceChildren();
+
+        todos.forEach((todo) => {
+          const item = document.createElement("li");
+          item.className = todo.completed ? "todo todo--completed" : "todo";
+
+          const title = document.createElement("span");
+          title.className = "todo__title";
+          title.textContent = todo.title;
+
+          const toggle = document.createElement("button");
+          toggle.type = "button";
+          toggle.className = "todo__toggle";
+          toggle.textContent = todo.completed ? "已完成" : "完成";
+          toggle.setAttribute(
+            "aria-label",
+            `${todo.completed ? "标记为未完成" : "完成"}：${todo.title}`
+          );
+          toggle.setAttribute("aria-pressed", String(todo.completed));
+          toggle.addEventListener("click", () => {
+            todo.completed = !todo.completed;
+            saveTodos();
+            renderTodos();
+          });
+
+          item.append(title, toggle);
+          todoList.append(item);
+        });
+      }
+
+      renderTodos();
+    </script>
   </body>
 </html>
