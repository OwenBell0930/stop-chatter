-body { font-family: system-ui, sans-serif; max-width: 640px; margin: 40px auto; }
-.requirement { color: #777; }
-.admin-link { font-weight: 700; }
+:root {
+  color: #172033;
+  background: #f7f8fa;
+  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
 
+* { box-sizing: border-box; }
+body { margin: 0; padding: 48px 20px; }
+.todo-app {
+  width: min(100%, 560px);
+  margin: 0 auto;
+  padding: 32px;
+  background: #fff;
+  border: 1px solid #e4e7ec;
+  border-radius: 16px;
+  box-shadow: 0 8px 24px rgb(23 32 51 / 6%);
+}
+h1 { margin: 0 0 24px; font-size: 28px; }
+.todo-list { display: grid; gap: 12px; padding: 0; margin: 0; list-style: none; }
+.usage-hint { margin: 16px 0 0; color: #7b8494; font-size: 14px; }
+.todo-item {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 16px;
+  border: 1px solid #e4e7ec;
+  border-radius: 10px;
+  background: #fff;
+}
+.todo-item.is-completed span { color: #7b8494; text-decoration: line-through; }
+.toggle-button {
+  flex: 0 0 auto;
+  padding: 8px 14px;
+  color: #2457d6;
+  background: #eef3ff;
+  border: 1px solid #cbd8ff;
+  border-radius: 8px;
+  cursor: pointer;
+  font: inherit;
+}
+.toggle-button:hover,
+.toggle-button[aria-pressed="true"] { color: #fff; background: #2457d6; }
