+    <main class="todo-app">
+      <header class="page-header">
+        <p class="eyebrow">TODAY</p>
+        <h1>待办清单</h1>
+        <p class="subtitle">完成一项，就向前一步。</p>
+      </header>
+      <section class="todo-card" aria-labelledby="todo-heading">
+        <div class="card-heading">
+          <h2 id="todo-heading">今天要做</h2>
+          <span id="remaining-count" class="count" aria-live="polite"></span>
+        </div>
