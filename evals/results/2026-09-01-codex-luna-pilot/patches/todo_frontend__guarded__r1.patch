+:root { color: #252a34; background: #f5f7fb; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
+* { box-sizing: border-box; }
+body { margin: 0; }
+.todo-app { width: min(100% - 40px, 640px); margin: 72px auto; }
+.page-header { margin-bottom: 28px; }
+.eyebrow { margin: 0 0 8px; color: #5872d8; font-size: 12px; font-weight: 700; letter-spacing: .14em; }
+h1 { margin: 0; font-size: clamp(32px, 6vw, 48px); line-height: 1.1; }
+.subtitle { margin: 12px 0 0; color: #697386; }
+.todo-card { padding: 24px; border: 1px solid #e4e8f0; border-radius: 18px; background: #fff; box-shadow: 0 16px 40px rgb(43 56 88 / 8%); }
+.card-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
+h2 { margin: 0; font-size: 20px; }
+.count { color: #697386; font-size: 14px; }
+.todo-list { display: grid; gap: 12px; margin: 20px 0 0; padding: 0; list-style: none; }
+.usage-hint { margin: 16px 0 0; color: #8791a3; font-size: 13px; }
+.todo-item { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px; border: 1px solid #edf0f5; border-radius: 12px; background: #fafbfe; }
+.todo-text { line-height: 1.5; }
+.is-complete .todo-text { color: #8791a3; text-decoration: line-through; }
+.toggle-button { flex: 0 0 auto; min-width: 68px; padding: 8px 12px; border: 1px solid #cbd4f7; border-radius: 8px; color: #4c63c8; background: #fff; font: inherit; cursor: pointer; }
+.toggle-button:hover { background: #f0f3ff; }
+.is-complete .toggle-button { border-color: #d9dee8; color: #697386; }
+@media (max-width: 520px) { .todo-app { margin: 40px auto; } .todo-card { padding: 18px; } }
