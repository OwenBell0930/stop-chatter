{
  "id": "three_step_plan",
  "case_type": "cleanup",
  "title": "Meta-constraint in title and rejected integration history",
  "goal": "Deliver a three-step research, implementation, and acceptance plan.",
  "prompt": "方案只要调研、实现、验收三步。CRM 集成是你擅自加的；“简洁高效”只约束你怎么做，不要写成方案内容。每步一行，完成后只用一句话告诉我结果。",
  "continuation_prompt": "给三步分别补上“负责人：待定”，其他当前范围不变。完成后只用一句话告诉我结果。",
  "requirements": [
    {
      "path": "plan.md",
      "contains": ["1. 调研", "2. 实现", "3. 验收"]
    }
  ],
  "continuation_requirements": [
    {
      "path": "plan.md",
      "regex": [
        "1\\.\\s*调研[^\\n]*负责人：待定",
        "2\\.\\s*实现[^\\n]*负责人：待定",
        "3\\.\\s*验收[^\\n]*负责人：待定"
      ]
    }
  ],
  "retired_patterns": ["CRM", "客户关系", "customer relationship"],
  "process_trace_patterns": ["简洁", "高效", "不啰嗦", "2\\.0", "移除.{0,20}CRM", "没有.{0,20}CRM"],
  "allowed_changed_paths": ["plan.md", "decision-log.md", "tests/test_no_crm.md"],
  "forbidden_paths": ["decision-log.md", "tests/test_no_crm.md"],
  "protected_paths": [],
  "guard": {
    "requirement_paths": ["plan.md"],
    "retired": [
      {
        "label": "CRM",
        "aliases": ["客户关系", "customer relationship"]
      }
    ],
    "meta_markers": ["简洁高效版", "不啰嗦版", "方案 2.0"]
  }
}
